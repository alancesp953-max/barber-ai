VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Firebase Web (Console > Project settings > Your apps). Reinicie o Vite após preencher.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Backend local da Diva (node server/index.mjs). Coloque serviceAccountKey.json na raiz.
# DIVA_LOCAL_PORT=8787

# Edge Functions secrets (configure no Supabase Dashboard ou via CLI — NÃO no Vite):
# UAZAPI_BASE_URL=https://seudominio.uazapi.com
# UAZAPI_INSTANCE_TOKEN=token-da-instancia
# WEBHOOK_SECRET=um-segredo-forte-aleatorio
# SUPABASE_SERVICE_ROLE_KEY=(já injetado pelo Supabase nas Edge Functions)
